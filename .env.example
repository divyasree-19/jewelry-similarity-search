# Copy to .env and adjust. Never commit .env.

# --- docker compose ---
SIGLIP_MODEL_DIR=/home/<you>/siglip2-base/model
EMBED_PORT=8000
# Only for `docker compose --profile siglip384 up -d` (EMBED_BACKEND=siglip2_384)
SIGLIP_384_MODEL_DIR=/home/<you>/siglip2-base-384/model
EMBED_384_PORT=8003
MONGO_PORT=27017

# --- backend ---
# siglip2_224 (chosen in Stage 6, see eval/DECISION.md) | siglip2_384 | vertex. Model name and version come from backend/app/embed_backends.py;
# each backend has its own index directory, so switching needs `python scripts/ingest.py` for that backend first.
EMBED_BACKEND=siglip2_224
EMBED_SERVICE_URL=http://localhost:8000
SIGLIP2_384_SERVICE_URL=http://localhost:8003
# vertex: VERTEX_ACCESS_TOKEN=$(gcloud auth print-access-token), or Application Default Credentials + google-auth
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
EMBED_TIMEOUT_SECONDS=30

MONGO_URI=mongodb://localhost:27017
MONGO_DB=jewellery_search

# Relative paths are resolved from the directory the backend is started in;
# leave unset to use <project>/data/faiss_index and <project>/data/catalogue.
# FAISS_INDEX_DIR=
# CATALOGUE_DIR=

# Preprocessing (shared by ingestion and query). Changing these means re-ingesting the catalogue.
PREPROCESS_SIZE=512
PREPROCESS_MIN_SIDE=128
# Background removal needs: pip install -r backend/requirements-bg.txt
PREPROCESS_REMOVE_BACKGROUND=false
PREPROCESS_REMBG_MODEL=isnet-general-use
PREPROCESS_NORMALIZE_LIGHTING=false

# Search API
SEARCH_CANDIDATES=100
SEARCH_MAX_TOP_K=50
MAX_UPLOAD_MB=10
# JSON list; only these origins may call the API from a browser (Vite dev server by default)
CORS_ORIGINS=["http://localhost:5173"]
# Uploaded query images are not kept unless this is true (saved to QUERY_IMAGE_DIR, default data/query_uploads)
SAVE_QUERY_IMAGES=false

# Stage 8 search: each step can be switched off (all false = the Stage 6 baseline)
SEARCH_HYBRID=true
SEARCH_BOOSTS=true
# Tags the query image with Qwen for boosts; adds ~4 s per image search on the shared server, so off
SEARCH_QUERY_TAGGING=false
SEARCH_RRF_K=60
# Category when none is given: siglip (zero-shot, ~free) or qwen (VLM call); ask the user below the threshold
CATEGORY_DETECTION=siglip
CATEGORY_CONFIDENCE_THRESHOLD=0.5
BOOST_GEMSTONES=0.002
BOOST_MOTIFS=0.001
BOOST_METAL=0.006
BOOST_STONE_COLORS=0.003
BOOST_STYLE=0.001
BOOST_CAP=0.01
# Image + text ("similar but in silver"): true = only show the requested metal; false = rank it first
REFINE_METAL_HARD_FILTER=false
# Text query without a category: all (search every category) or ask
TEXT_NO_CATEGORY=all
# Stage 9 features (build first: python scripts/build_feature_indexes.py --feature gray|tiles).
# Results in eval/results/stage9_decision.md: gray/edge did not help (off); 2x2 region rerank did (on, ~+1.2 s on CPU)
FEATURE_GRAY_RETRIEVAL=false
FEATURE_GRAY_RERANK=false
FEATURE_GRAY_RERANK_WEIGHT=0.02
FEATURE_EDGE_RETRIEVAL=false
FEATURE_EDGE_RERANK=false
FEATURE_RERANK_TOP_N=100
FEATURE_REGION_RERANK=true
FEATURE_REGION_WEIGHT=0.02
FEATURE_REGION_TOP_N=50
FEATURE_TILE_GRID=2
# Stage 10 re-ranking (eval/results/stage10_final.md): tuned weights helped text search, hurt image search
SEARCH_RERANKER=true
RERANKER_MODES=text
RERANKER_WEIGHTS_VERSION=v2
RERANKER_TOP_N=100
DEDUP_NEAR_DUPLICATE_THRESHOLD=0.98
# Qwen same-design check on the top 5: +2 of 50 at rank 1 for ~+4.5 s p95, so off
FEATURE_VLM_JUDGE=false
VLM_JUDGE_TOP_N=5
VLM_JUDGE_WEIGHT=0.1
VLM_JUDGE_TIMEOUT_SECONDS=20
VLM_JUDGE_CONCURRENCY=5
# Query parsing LLM; leave empty to reuse the VLM endpoint, model and key below
LLM_SERVICE_URL=
LLM_MODEL_NAME=
LLM_API_KEY=

# Stage 7 tagging VLM: OpenAI-compatible base URL (ending in /v1). The key is read from VLM_API_KEY or QWEN_API_KEY.
VLM_SERVICE_URL=https://llm-dev.vivaquest.in/qwen/v1
VLM_MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct
QWEN_API_KEY=
VLM_QUANTIZATION=none
VLM_CONCURRENCY=4

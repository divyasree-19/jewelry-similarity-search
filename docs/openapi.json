{
  "openapi": "3.1.0",
  "info": {
    "title": "Jewellery Search Backend",
    "version": "0.1.0"
  },
  "paths": {
    "/search/image": {
      "post": {
        "summary": "Search Image",
        "operationId": "search_image_search_image_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_search_image_search_image_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid request: missing or malformed field, unknown category, bad top_k, empty, corrupt or too-small image"
          },
          "404": {
            "description": "Nothing is indexed for the category (or at all)"
          },
          "503": {
            "description": "A dependency is unavailable: embedding service (SigLIP), catalogue database (MongoDB), query parser (Qwen, text search only), or the category's index does not match the current settings"
          },
          "413": {
            "description": "Image larger than MAX_UPLOAD_MB"
          },
          "415": {
            "description": "Not a JPEG, PNG or WebP image (declared type or file content)"
          }
        }
      }
    },
    "/search/text": {
      "post": {
        "summary": "Search Text",
        "operationId": "search_text_search_text_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TextSearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid request: missing or malformed field, unknown category, bad top_k, empty, corrupt or too-small image"
          },
          "404": {
            "description": "Nothing is indexed for the category (or at all)"
          },
          "503": {
            "description": "A dependency is unavailable: embedding service (SigLIP), catalogue database (MongoDB), query parser (Qwen, text search only), or the category's index does not match the current settings"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "Degraded: MongoDB or the embedding service is down"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_search_image_search_image_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "JPEG, PNG or WebP photo"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category",
            "description": "Omit to detect it"
          },
          "text": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text",
            "description": "Optional refinement, e.g. \"similar but in silver\""
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "subcategory": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subcategory"
          },
          "top_k": {
            "type": "integer",
            "title": "Top K",
            "default": 10
          },
          "debug": {
            "type": "boolean",
            "title": "Debug",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_search_image_search_image_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TextSearchRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Text"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "top_k": {
            "type": "integer",
            "title": "Top K",
            "default": 10
          },
          "debug": {
            "type": "boolean",
            "title": "Debug",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TextSearchRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}

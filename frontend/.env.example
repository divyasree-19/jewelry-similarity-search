# Copy to frontend/.env. Vite reads it at startup, so restart `npm run dev` after changing it.

# Backend base URL, no trailing slash. The backend's CORS_ORIGINS must include http://localhost:5173.
VITE_API_URL=http://localhost:8080

# Largest upload accepted before sending; keep equal to the backend's MAX_UPLOAD_MB
VITE_MAX_UPLOAD_MB=10

# Request timeouts in milliseconds. Image + text searches take a few seconds on CPU.
VITE_SEARCH_TIMEOUT_MS=60000
VITE_HEALTH_TIMEOUT_MS=5000
